[core]
    editor = nvim

[commit]
    gpgSign = true

[tag]
    forceSignAnnotated = true

[gpg]
{{- if $useGpg }}
    format = openpgp
    program = gpg
{{- else }}
    format = ssh
{{- end }}
{{- if not $useGpg }}

[gpg "ssh"]
    allowedSigners = /home/smallten/.ssh/allowedSigners
{{- end }}
