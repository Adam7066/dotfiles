[user]
    name = Smallten
    email = smallten@proton.me
{{ if eq .chezmoi.os "darwin" -}}
    signingKey = "091C610D2F80EAD3A54ABDCF71A90CEE9EB01E69"
{{ else if eq .chezmoi.os "linux" -}}
    signingKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILAXCpk743cbLNMF6a6UN+qgRXAtgq24Nm1PGjUfq8wf"
{{ end }}

[core]
    editor = nvim

[commit]
    gpgSign = true

[tag]
    forceSignAnnotated = true

[gpg]
{{ if eq .chezmoi.os "darwin" -}}
    format = openpgp
    program = gpg
{{ else if eq .chezmoi.os "linux" -}}
    format = ssh
{{ end }}

{{ if eq .chezmoi.os "linux" -}}
[gpg "ssh"]
    allowedSigners = /home/smallten/.ssh/allowedSigners
{{ end }}