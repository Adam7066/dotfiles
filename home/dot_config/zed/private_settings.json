{
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 16.0,
  "ui_font_family": "Hack Nerd Font Mono",
  "ui_font_size": 16.0,
  "terminal": {
    "font_family": "Hack Nerd Font Mono",
    "font_size": 16.0,
  },
  "project_panel": {
    "dock": "left",
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus",
      },
      "type": "registry",
    },
  },
  "auto_install_extensions": {
    "html": true,
    "toml": true,
  },
  "languages": {
    "PHP": {
      "language_servers": ["phpactor", "!intelephense", "!phptools", "!phpantom", "..."]
    }
  }
}
