{
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 16.0,
  "ui_font_family": "Hack Nerd Font Mono",
  "ui_font_size": 16.0,
  "terminal": {
    "font_family": "Hack Nerd Font Mono",
    "font_size": 16.0
  },
  "project_panel": {
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "html": true,
    "toml": true
  }
}
