layout {

    focus-ring {
        active-color   "#f7e9a8"
        inactive-color "#15162e"
        urgent-color   "#ed8296"
    }

    border {
        active-color   "#f7e9a8"
        inactive-color "#15162e"
        urgent-color   "#ed8296"
    }


    tab-indicator {
        active-color   "#f7e9a8"
        inactive-color "#585552"
        urgent-color   "#ed8296"
    }

    insert-hint {
        color "#f7e9a880"
    }
}

recent-windows {
    highlight {
        active-color "#f7e9a8"
        urgent-color "#ed8296"
    }
}
